.gifts-container {
  padding: 32rpx;
  padding-bottom: 120rpx;
}

.summary-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.summary-content {
  display: flex;
  flex-direction: column;
}

.summary-card .summary-label {
  font-size: 26rpx;
  margin-bottom: 8rpx;
}

.summary-card .summary-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.export-btn {
  background: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
  border-radius: 32rpx;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

.search-bar {
  position: relative;
}

.search-input {
  width: 100%;
  max-width: 680rpx;
  height: 88rpx;
  background: #FFFFFF;
  border-radius: 44rpx;
  padding: 0 32rpx 0 80rpx;
  font-size: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

.search-icon {
  position: absolute;
  left: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 32rpx;
}

.gifts-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.gift-card {
  display: flex;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.gift-avatar {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #D4A574 0%, #E8B4B8 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.gift-info {
  flex: 1;
}

.gift-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.gift-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.gift-relation {
  font-size: 22rpx;
  color: #D4A574;
  background: #FDF8F3;
  padding: 6rpx 12rpx;
  border-radius: 16rpx;
}

.gift-note {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 8rpx;
}

.gift-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.gift-date {
  font-size: 24rpx;
  color: #999999;
}

.gift-amount {
  font-size: 32rpx;
  font-weight: 600;
  color: #D4A574;
}

.gift-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.action-icon {
  width: 56rpx;
  height: 56rpx;
  background: #F5F5F5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #666666;
}

.action-icon.delete {
  color: #FF4D4F;
}

.relation-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.relation-item {
  padding: 16rpx 28rpx;
  background: #F5F5F5;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #666666;
}

.relation-item.selected {
  background: #FDF8F3;
  color: #D4A574;
  border: 2rpx solid #D4A574;
}

.picker-section {
  margin-bottom: 20rpx;
}

.picker-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FDF8F3 0%, #F5EEE6 100%);
  border: 2rpx dashed #D4A574;
  border-radius: 16rpx;
  padding: 20rpx;
}

.picker-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.picker-text {
  font-size: 28rpx;
  color: #D4A574;
}

.guest-picker-modal {
  max-height: 70vh;
}

.guest-picker-modal .modal-body {
  max-height: 50vh;
  overflow-y: auto;
}

.guest-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.guest-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #F9F9F9;
  border-radius: 16rpx;
}

.guest-item .guest-avatar {
  width: 64rpx;
  height: 64rpx;
  margin-right: 16rpx;
}

.guest-item .guest-info {
  flex: 1;
}

.guest-item .guest-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  display: block;
}

.guest-item .guest-relation {
  font-size: 24rpx;
  color: #999999;
}

.select-icon {
  font-size: 32rpx;
  color: #D4A574;
  font-weight: 600;
}
