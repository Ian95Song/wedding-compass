.checklist-container {
  min-height: 100vh;
  background: #FFF9F5;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.category-picker {
  padding: 24rpx 32rpx;
  background: #FFFFFF;
}

.picker-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #F5F5F5;
  border-radius: 16rpx;
}

.picker-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.picker-arrow {
  font-size: 24rpx;
  color: #999999;
}

.progress-section {
  margin: 24rpx 32rpx;
  padding: 28rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(212, 165, 116, 0.1);
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.progress-text {
  font-size: 28rpx;
  color: #666666;
}

.progress-percent {
  font-size: 34rpx;
  font-weight: 700;
  color: #D4A574;
}

.empty-state {
  margin: 120rpx 32rpx;
  padding: 80rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.05);
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

.items-list {
  padding: 0 32rpx;
}

.item-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s ease;
}

.item-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
}

.item-checkbox {
  width: 52rpx;
  height: 52rpx;
  border: 3rpx solid #E8D5C4;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.item-checkbox.checked {
  background: linear-gradient(135deg, #D4A574 0%, #C4956A 100%);
  border-color: #D4A574;
}

.check-icon {
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: bold;
}

.item-info {
  flex: 1;
}

.item-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  display: block;
}

.item-name.checked {
  color: #CCCCCC;
  text-decoration: line-through;
}

.item-note {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
  display: block;
}

.item-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-left: 20rpx;
}

.action-btn {
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.action-btn:active {
  transform: scale(0.95);
}

.action-btn.edit {
  color: #D4A574;
  background: #FFF5EB;
}

.action-btn.delete {
  color: #FF4D4F;
  background: #FFF1F0;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.add-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #D4A574 0%, #C4956A 100%);
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(212, 165, 116, 0.35);
  transition: all 0.2s ease;
}

.add-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(212, 165, 116, 0.3);
}

.modal-content {
  border-radius: 32rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
}

.modal-header {
  border-bottom: 1rpx solid #F5F5F5;
}

.modal-close {
  color: #CCCCCC;
  transition: color 0.2s ease;
}

.modal-close:active {
  color: #999999;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 16rpx;
  display: block;
}

.form-input {
  height: 92rpx;
  background: #FAFAFA;
  border-radius: 20rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.form-input:focus {
  background: #FFFFFF;
  border-color: #D4A574;
}

.form-textarea {
  height: 160rpx;
  background: #FAFAFA;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.form-textarea:focus {
  background: #FFFFFF;
  border-color: #D4A574;
}

.modal-footer {
  border-top: 1rpx solid #F5F5F5;
}

.modal-footer button {
  height: 92rpx;
  border-radius: 46rpx;
  font-size: 30rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.modal-footer button:active {
  transform: scale(0.98);
}

.btn-cancel {
  background: #F5F5F5;
  color: #666666;
  border: none;
}

.btn-save {
  background: linear-gradient(135deg, #D4A574 0%, #C4956A 100%);
  color: #FFFFFF;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(212, 165, 116, 0.3);
}
