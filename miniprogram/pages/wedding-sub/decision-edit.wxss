.edit-container {
  padding: 0;
}

.category-banner {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
  color: #FFFFFF;
  margin-bottom: 32rpx;
}

.category-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.category-name {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.category-tip {
  font-size: 24rpx;
  opacity: 0.9;
}

.form-section {
  margin: 0 32rpx 32rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.form-input {
  background: #FFFFFF;
  border: 2rpx solid #F0F0F0;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  color: #333333;
  line-height: 100rpx;
  height: 100rpx;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #D4A574;
  outline: none;
}

.form-input::placeholder {
  color: #CCCCCC;
  font-size: 30rpx;
  line-height: 100rpx;
}

.form-textarea {
  background: #FFFFFF;
  border: 2rpx solid #F0F0F0;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #333333;
  min-height: 160rpx;
  width: 100%;
  box-sizing: border-box;
  line-height: 1.6;
}

.form-textarea::placeholder {
  color: #CCCCCC;
  font-size: 28rpx;
}

.image-upload-area {
  margin-top: 16rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.image-preview {
  width: 100%;
  height: 100%;
}

.image-delete {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #FFFFFF;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 0 0 16rpx;
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  background: #F5F5F5;
  border: 2rpx dashed #D4A574;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 48rpx;
  color: #D4A574;
  line-height: 1;
}

.add-text {
  font-size: 24rpx;
  color: #D4A574;
  margin-top: 8rpx;
}

.image-tip {
  font-size: 22rpx;
  color: #999999;
  margin-top: 12rpx;
}

.form-actions {
  margin-top: 48rpx;
  padding-bottom: 48rpx;
}

.form-actions .btn-primary {
  width: 100%;
}
