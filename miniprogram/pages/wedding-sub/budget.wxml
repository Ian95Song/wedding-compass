<view class="budget-container">
  <view class="summary-card">
    <view class="summary-item">
      <text class="summary-label">总预算</text>
      <text class="summary-value">¥{{formattedTotal}}</text>
    </view>
    <view class="summary-item">
      <text class="summary-label">已支付</text>
      <text class="summary-value text-success">¥{{formattedSpent}}</text>
    </view>
    <view class="summary-item">
      <text class="summary-label">待支付</text>
      <text class="summary-value text-warning">¥{{formattedRemaining}}</text>
    </view>
  </view>

  <view class="progress-section">
    <view class="progress-header">
      <text class="progress-title">支付进度</text>
      <text class="progress-percent">{{progressPercent}}%</text>
    </view>
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{progressPercent}}%"></view>
    </view>
  </view>

  <view class="action-bar">
    <button class="add-btn" bindtap="addBudget">+ 添加预算</button>
  </view>

  <view wx:if="{{budgetList.length === 0}}" class="empty-state">
    <text class="empty-icon">💰</text>
    <text class="empty-title">暂无预算记录</text>
    <text class="empty-desc">点击上方按钮添加预算</text>
  </view>

  <view wx:else class="budget-list">
    <view 
      wx:for="{{budgetList}}" 
      wx:key="id" 
      class="budget-card"
    >
      <view class="budget-header">
        <view class="category-icon">{{getCategoryInfo(item.category).icon}}</view>
        <view class="budget-info">
          <text class="budget-description">{{item.description}}</text>
          <text class="budget-category">{{getCategoryInfo(item.category).name}}</text>
        </view>
        <view class="paid-badge {{item.isPaid ? 'paid' : 'unpaid'}}">
          {{item.isPaid ? '已支付' : '待支付'}}
        </view>
      </view>
      <view class="budget-footer">
        <view class="budget-date">{{item.date}}</view>
        <view class="budget-amount">¥{{item.formattedAmount}}</view>
      </view>
      <view class="budget-actions">
        <text class="action-text" bindtap="togglePaidStatus" data-id="{{item.id}}">{{item.isPaid ? '标记未支付' : '标记已支付'}}</text>
        <text class="action-text" bindtap="editBudget" data-id="{{item.id}}">编辑</text>
        <text class="action-text delete" bindtap="deleteBudget" data-id="{{item.id}}">删除</text>
      </view>
    </view>
  </view>
</view>

<view wx:if="{{showAddModal}}" class="modal-overlay" bindtap="closeModal">
  <view class="modal-content" catchtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">{{editingItem ? '编辑预算' : '添加预算'}}</text>
      <text class="modal-close" bindtap="closeModal">×</text>
    </view>
    <view class="modal-body">
      <view class="form-section">
        <text class="form-label">分类</text>
        <view class="category-grid">
          <view 
            wx:for="{{categories}}" 
            wx:key="id" 
            class="category-item {{formData.category === item.id ? 'selected' : ''}}"
            bindtap="selectCategory"
            data-id="{{item.id}}"
          >
            <text>{{item.icon}}</text>
            <text>{{item.name}}</text>
          </view>
        </view>
      </view>
      <input class="form-input" placeholder="描述" value="{{formData.description}}" bindinput="onInput" data-field="description" />
      <input class="form-input" type="number" placeholder="金额（元）" value="{{formData.amount}}" bindinput="onInput" data-field="amount" />
      <input class="form-input" placeholder="日期" value="{{formData.date}}" bindinput="onInput" data-field="date" />
      <view class="form-switch">
        <text class="switch-label">已支付</text>
        <switch value="{{formData.isPaid}}" bindchange="togglePaid" />
      </view>
    </view>
    <view class="modal-footer">
      <button class="btn-secondary" bindtap="closeModal">取消</button>
      <button class="btn-primary" bindtap="saveBudget">保存</button>
    </view>
  </view>
</view>
