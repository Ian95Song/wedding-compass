.guests-container {
  padding: 32rpx;
  padding-bottom: 120rpx;
}

.summary-card {
  display: flex;
  background: linear-gradient(135deg, #D4A574 0%, #C4956A 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.summary-value.text-success {
  color: #90EE90;
}

.summary-value.text-warning {
  color: #FFD700;
}

.summary-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.summary-divider {
  width: 1rpx;
  background: rgba(255, 255, 255, 0.3);
  margin: 0 24rpx;
}

.search-bar {
  position: relative;
  margin-bottom: 24rpx;
}

.search-input {
  width: 100%;
  max-width: 680rpx;
  height: 88rpx;
  background: #FFFFFF;
  border-radius: 44rpx;
  padding: 0 32rpx 0 80rpx;
  font-size: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

.search-icon {
  position: absolute;
  left: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 32rpx;
}

.filter-section {
  margin-bottom: 24rpx;
}

.filter-tabs {
  display: flex;
  background: #F5F5F5;
  border-radius: 24rpx;
  padding: 8rpx;
}

.filter-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #666666;
  transition: all 0.2s ease;
}

.filter-tab.active {
  background: #FFFFFF;
  color: #D4A574;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.filter-tab.groom.active {
  background: #E8F4F8;
  color: #4A6FA5;
}

.filter-tab.bride.active {
  background: #FDF8F3;
  color: #D4A574;
}

.tab-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.tab-text {
  font-size: 28rpx;
}

.action-bar {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.add-btn {
  flex: 1;
  background: linear-gradient(135deg, #D4A574 0%, #C4956A 100%);
  color: #FFFFFF;
  border-radius: 40rpx;
  padding: 28rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}

.import-btn {
  background: #FFFFFF;
  color: #D4A574;
  border-radius: 40rpx;
  padding: 28rpx 32rpx;
  font-size: 28rpx;
  border: 2rpx solid #D4A574;
}

.empty-state {
  text-align: center;
  padding: 80rpx 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999999;
}

.guests-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.guest-card {
  display: flex;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.guest-avatar {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #D4A574 0%, #E8B4B8 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.guest-info {
  flex: 1;
}

.guest-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 8rpx;
}

.guest-badges {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  align-items: flex-end;
}

.guest-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.relation-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.confirmed-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.confirmed-badge.confirmed {
  background: #E6F7E6;
  color: #52C41A;
}

.confirmed-badge.unconfirmed {
  background: #FFF7E6;
  color: #FAAD14;
}

.guest-details {
  display: flex;
  gap: 20rpx;
  margin-bottom: 8rpx;
}

.guest-phone, .guest-relation {
  font-size: 24rpx;
  color: #999999;
}

.guest-table, .guest-note {
  font-size: 22rpx;
  color: #666666;
  margin-bottom: 4rpx;
}

.guest-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.action-icon {
  width: 56rpx;
  height: 56rpx;
  background: #F5F5F5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #666666;
}

.action-icon.delete {
  color: #FF4D4F;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 90%;
  max-width: 640rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
}

.modal-close {
  font-size: 48rpx;
  color: #999999;
  line-height: 1;
}

.modal-body {
  padding: 32rpx;
}

.form-section {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #999999;
  display: block;
  margin-bottom: 16rpx;
}

.relation-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.relation-group {
  background: #F9F9F9;
  border-radius: 16rpx;
  padding: 20rpx;
}

.group-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
  display: block;
}

.relation-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.relation-item {
  padding: 12rpx 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #666666;
  border: 2rpx solid #E8E8E8;
}

.relation-item.selected {
  border: 2rpx solid #D4A574;
}

.relation-item.selected.groom {
  background: #E8F4F8;
  color: #4A6FA5;
  border-color: #4A6FA5;
}

.relation-item.selected.bride {
  background: #FDF8F3;
  color: #D4A574;
  border-color: #D4A574;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #F9F9F9;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.form-textarea {
  width: 100%;
  height: 120rpx;
  background: #F9F9F9;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.form-switch {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.switch-label {
  font-size: 28rpx;
  color: #333333;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #F0F0F0;
}

.modal-footer button {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #D4A574 0%, #C4956A 100%);
  color: #FFFFFF;
  border: none;
}

.btn-secondary {
  background: #F5F5F5;
  color: #333333;
  border: none;
}

.import-options {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.import-option {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #F9F9F9;
  border-radius: 16rpx;
}

.option-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.option-info {
  flex: 1;
}

.option-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 8rpx;
}

.option-desc {
  font-size: 24rpx;
  color: #999999;
}
