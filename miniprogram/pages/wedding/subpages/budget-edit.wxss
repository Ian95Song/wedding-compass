.edit-container {
  padding: 32rpx;
  padding-bottom: 120rpx;
}

.form-section {
  margin-bottom: 36rpx;
}

.form-label {
  font-size: 30rpx;
  color: #333333;
  margin-bottom: 16rpx;
  font-weight: 500;
  line-height: 1.4;
}

.form-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  border: 2rpx solid #F0F0F0;
  transition: border-color 0.2s ease;
}

.form-picker:active {
  border-color: #D4A574;
}

.picker-text {
  color: #333333;
  font-size: 30rpx;
}

.picker-text.placeholder {
  color: #999999;
}

.picker-arrow {
  color: #CCCCCC;
  font-size: 36rpx;
  font-weight: bold;
}

.form-input {
  width: 100%;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 0 24rpx;
  border: 2rpx solid #F0F0F0;
  font-size: 32rpx;
  color: #333333;
  line-height: 100rpx;
  height: 100rpx;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #D4A574;
  outline: none;
}

.form-input::placeholder {
  color: #CCCCCC;
  font-size: 30rpx;
  line-height: 100rpx;
}

.amount-input-wrapper {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 0 24rpx;
  border: 2rpx solid #F0F0F0;
  transition: border-color 0.2s ease;
  height: 100rpx;
}

.amount-input-wrapper:focus-within {
  border-color: #D4A574;
}

.amount-input {
  flex: 1;
  background: transparent;
  font-size: 32rpx;
  color: #333333;
  line-height: 100rpx;
  height: 100rpx;
}

.amount-input::placeholder {
  color: #CCCCCC;
  font-size: 30rpx;
  line-height: 100rpx;
}

.input-prefix {
  font-size: 32rpx;
  color: #D4A574;
  font-weight: 600;
  margin-right: 12rpx;
}

.form-switch-wrapper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  border: 2rpx solid #F0F0F0;
}

.form-switch-label {
  font-size: 30rpx;
  color: #333333;
}

.form-actions {
  margin-top: 60rpx;
}

.form-actions .btn-primary {
  width: 100%;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #D4A574 0%, #C4956A 100%);
  color: #FFFFFF;
  border: none;
}

.form-actions .btn-primary:active {
  opacity: 0.85;
}
