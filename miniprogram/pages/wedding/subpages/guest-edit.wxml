<view class="edit-container">
  <view class="form-section">
    <view class="form-label">宾客姓名 *</view>
    <input class="form-input" placeholder="请输入宾客姓名" value="{{formData.name}}" bindinput="onNameInput" />
  </view>

  <view class="form-section">
    <view class="form-label">联系电话</view>
    <input class="form-input" type="number" placeholder="请输入电话号码" value="{{formData.phone}}" bindinput="onPhoneInput" />
  </view>

  <view class="form-section">
    <view class="form-label">关系</view>
    <input class="form-input" placeholder="如：男方亲戚、女方朋友、同事" value="{{formData.relation}}" bindinput="onRelationInput" />
  </view>

  <view class="form-section">
    <view class="form-label">桌号</view>
    <input class="form-input" type="number" placeholder="请输入桌号" value="{{formData.table}}" bindinput="onTableInput" />
  </view>

  <view class="form-section">
    <view class="form-label">备注</view>
    <textarea class="form-textarea" placeholder="如：带妻子和孩子" value="{{formData.note}}" bindinput="onNoteInput" />
  </view>

  <view class="form-actions">
    <button class="btn-primary" bindtap="save">保存</button>
  </view>
</view>
