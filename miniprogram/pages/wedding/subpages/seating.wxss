.seating-container {
  padding: 32rpx;
  padding-bottom: 120rpx;
}

.summary-card {
  display: flex;
  background: linear-gradient(135deg, #D4A574 0%, #C4956A 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.summary-value.text-success {
  color: #90EE90;
}

.summary-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.summary-divider {
  width: 1rpx;
  background: rgba(255, 255, 255, 0.3);
  margin: 0 24rpx;
}

.action-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.add-btn {
  flex: 1;
  background: linear-gradient(135deg, #D4A574 0%, #C4956A 100%);
  color: #FFFFFF;
  border-radius: 40rpx;
  padding: 24rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.export-btn {
  background: #FFFFFF;
  color: #D4A574;
  border-radius: 40rpx;
  padding: 24rpx 32rpx;
  font-size: 26rpx;
  border: 2rpx solid #D4A574;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.btn-text {
  font-size: 28rpx;
}

.tables-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.table-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.table-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.table-number {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.table-name {
  font-size: 22rpx;
  color: #D4A574;
  background: #FDF8F3;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.table-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.info-row {
  display: flex;
  flex-direction: column;
}

.info-label {
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 4rpx;
}

.info-value {
  font-size: 26rpx;
  color: #666666;
  font-weight: 500;
}

.info-value.full {
  color: #D4A574;
}

.table-progress {
  margin-bottom: 12rpx;
}

.progress-bar {
  height: 8rpx;
  background: #F5F5F5;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #D4A574 0%, #E8B4B8 100%);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.progress-fill.full {
  background: linear-gradient(90deg, #D4A574 0%, #C4956A 100%);
}

.table-guests-preview {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
  min-height: 40rpx;
}

.guest-mini {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #D4A574 0%, #C4956A 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.guest-avatar-mini {
  font-size: 20rpx;
  color: #FFFFFF;
}

.guest-more {
  font-size: 22rpx;
  color: #999999;
}

.empty-text {
  font-size: 22rpx;
  color: #CCCCCC;
}

.table-actions {
  display: flex;
  gap: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 12rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
}

.action-btn.primary {
  background: #FDF8F3;
  color: #D4A574;
}

.action-btn.secondary {
  background: #F5F5F5;
  color: #666666;
}

.action-btn.danger {
  background: #FFF0F0;
  color: #FF4D4F;
}

.empty-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999999;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 90%;
  max-width: 640rpx;
  max-height: 80vh;
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-content.modal-lg {
  max-width: 720rpx;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
}

.modal-subtitle {
  font-size: 26rpx;
  color: #999999;
  margin-left: 16rpx;
}

.modal-close {
  font-size: 48rpx;
  color: #999999;
  line-height: 1;
}

.modal-body {
  padding: 32rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.modal-body.assign-modal {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #F9F9F9;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #F0F0F0;
}

.modal-footer button {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #D4A574 0%, #C4956A 100%);
  color: #FFFFFF;
  border: none;
}

.btn-secondary {
  background: #F5F5F5;
  color: #333333;
  border: none;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.section-count {
  font-size: 24rpx;
  color: #D4A574;
}

.section-count.full {
  color: #FF4D4F;
}

.assigned-section, .available-section {
  background: #F9F9F9;
  border-radius: 16rpx;
  padding: 20rpx;
}

.assigned-list, .available-list {
  max-height: 240rpx;
}

.assigned-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.assigned-item .guest-info {
  display: flex;
  align-items: center;
}

.guest-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #D4A574 0%, #C4956A 100%);
  color: #FFFFFF;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.assigned-item .guest-name {
  font-size: 28rpx;
  color: #333333;
}

.remove-btn {
  font-size: 24rpx;
  color: #FF4D4F;
  padding: 8rpx 16rpx;
  border: 1rpx solid #FF4D4F;
  border-radius: 12rpx;
}

.available-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.available-item .guest-info {
  flex: 1;
  display: flex;
  align-items: center;
}

.available-item .guest-detail {
  display: flex;
  flex-direction: column;
}

.available-item .guest-phone {
  font-size: 22rpx;
  color: #999999;
}

.add-btn-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #D4A574 0%, #C4956A 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-state {
  text-align: center;
  padding: 32rpx;
  font-size: 26rpx;
  color: #999999;
}

.table-name-display {
  background: #FDF8F3;
  padding: 16rpx;
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
  color: #D4A574;
  margin-bottom: 24rpx;
}

.table-info-card {
  display: flex;
  gap: 32rpx;
  margin-bottom: 24rpx;
}

.info-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #F9F9F9;
  padding: 20rpx;
  border-radius: 12rpx;
}

.info-item-label {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.info-item-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.guest-list-detail {
  max-height: 400rpx;
  overflow-y: auto;
}

.guest-detail-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.guest-detail-item:last-child {
  border-bottom: none;
}

.guest-avatar-lg {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #D4A574 0%, #C4956A 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.guest-info-detail {
  flex: 1;
}

.guest-name-lg {
  font-size: 30rpx;
  color: #333333;
  display: block;
}