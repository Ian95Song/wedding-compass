<view class="gifts-container">
  <view class="summary-card">
    <view class="summary-content">
      <text class="summary-label">礼金总收入</text>
      <text class="summary-value">¥{{formattedTotal}}</text>
    </view>
  </view>

  <view class="search-bar">
    <input 
      class="search-input" 
      placeholder="搜索宾客" 
      value="{{searchText}}" 
      bindinput="onSearchInput"
    />
    <text class="search-icon">🔍</text>
  </view>

  <view class="action-bar">
    <button class="add-btn" bindtap="addGift">+ 添加记录</button>
  </view>

  <view wx:if="{{filteredGifts.length === 0}}" class="empty-state">
    <text class="empty-icon">🎁</text>
    <text class="empty-title">暂无礼金记录</text>
    <text class="empty-desc">点击上方按钮添加记录</text>
  </view>

  <view wx:else class="gifts-list">
    <view 
      wx:for="{{filteredGifts}}" 
      wx:key="id" 
      class="gift-card"
    >
      <view class="gift-avatar">
        <text class="avatar-text">{{item.name.charAt(0)}}</text>
      </view>
      <view class="gift-info">
        <view class="gift-header">
          <text class="gift-name">{{item.name}}</text>
          <text class="gift-relation">{{item.relation}}</text>
        </view>
        <view wx:if="{{item.note}}" class="gift-note">
          <text>{{item.note}}</text>
        </view>
        <view class="gift-footer">
          <text class="gift-date">{{item.date}}</text>
          <text class="gift-amount">¥{{item.formattedAmount}}</text>
        </view>
      </view>
      <view class="gift-actions">
        <text class="action-icon" bindtap="editGift" data-id="{{item.id}}">✎</text>
        <text class="action-icon delete" bindtap="deleteGift" data-id="{{item.id}}">✕</text>
      </view>
    </view>
  </view>
</view>

<view wx:if="{{showAddModal}}" class="modal-overlay" bindtap="closeModal">
  <view class="modal-content" catchtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">{{editingGift ? '编辑记录' : '添加记录'}}</text>
      <text class="modal-close" bindtap="closeModal">×</text>
    </view>
    <view class="modal-body">
      <input class="form-input" placeholder="姓名" value="{{formData.name}}" bindinput="onInput" data-field="name" />
      <view class="picker-section">
        <view class="picker-btn" bindtap="openGuestPicker">
          <text class="picker-icon">👥</text>
          <text class="picker-text">从宾客名单中选</text>
        </view>
      </view>
      <input class="form-input" type="number" placeholder="金额（元）" value="{{formData.amount}}" bindinput="onInput" data-field="amount" />
      <view class="form-section">
        <text class="form-label">关系</text>
        <view class="relation-grid">
          <view 
            wx:for="{{relations}}" 
            wx:key="*this" 
            class="relation-item {{formData.relation === item ? 'selected' : ''}}"
            bindtap="selectRelation"
            data-value="{{item}}"
          >
            {{item}}
          </view>
        </view>
      </view>
      <textarea class="form-textarea" placeholder="备注（可选）" value="{{formData.note}}" bindinput="onInput" data-field="note" />
    </view>
    <view class="modal-footer">
      <button class="btn-secondary" bindtap="closeModal">取消</button>
      <button class="btn-primary" bindtap="saveGift">保存</button>
    </view>
  </view>
</view>

<view wx:if="{{showGuestPicker}}" class="modal-overlay" bindtap="closeGuestPicker">
  <view class="modal-content guest-picker-modal" catchtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">选择宾客</text>
      <text class="modal-close" bindtap="closeGuestPicker">×</text>
    </view>
    <view class="modal-body">
      <view wx:if="{{availableGuests.length === 0}}" class="empty-state">
        <text class="empty-icon">👥</text>
        <text class="empty-title">暂无可用宾客</text>
        <text class="empty-desc">可直接手动输入姓名</text>
      </view>
      <view wx:else class="guest-list">
        <view 
          wx:for="{{availableGuests}}" 
          wx:key="id" 
          class="guest-item"
          bindtap="selectGuest"
          data-name="{{item.name}}"
          data-relation="{{item.relation}}"
        >
          <view class="guest-avatar">
            <text class="avatar-text">{{item.name.charAt(0)}}</text>
          </view>
          <view class="guest-info">
            <text class="guest-name">{{item.name}}</text>
            <text class="guest-relation">{{item.relation}}</text>
          </view>
          <text class="select-icon">✓</text>
        </view>
      </view>
    </view>
  </view>
</view>
