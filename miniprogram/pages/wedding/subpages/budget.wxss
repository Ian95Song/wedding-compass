.budget-container {
  padding: 32rpx;
  padding-bottom: 120rpx;
}

.summary-card {
  background: linear-gradient(135deg, #D4A574 0%, #C4956A 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.summary-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.summary-item:not(:last-child) {
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.2);
}

.summary-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.summary-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.summary-value.text-success {
  color: #90EE90;
}

.summary-value.text-warning {
  color: #FFD700;
}

.progress-section {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.progress-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.progress-percent {
  font-size: 32rpx;
  font-weight: 600;
  color: #D4A574;
}

.progress-bar {
  height: 16rpx;
  background: #F5F5F5;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #D4A574 0%, #E8B4B8 100%);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.action-bar {
  margin-bottom: 24rpx;
}

.add-btn {
  width: 100%;
  background: linear-gradient(135deg, #D4A574 0%, #C4956A 100%);
  color: #FFFFFF;
  border-radius: 40rpx;
  padding: 28rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}

.empty-state {
  text-align: center;
  padding: 80rpx 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999999;
}

.budget-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.budget-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.budget-header {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.category-icon {
  width: 72rpx;
  height: 72rpx;
  background: #FDF8F3;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 20rpx;
}

.budget-info {
  flex: 1;
}

.budget-description {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 8rpx;
}

.budget-category {
  font-size: 24rpx;
  color: #999999;
}

.paid-badge {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.paid-badge.paid {
  background: #E6F7E6;
  color: #52C41A;
}

.paid-badge.unpaid {
  background: #FFF7E6;
  color: #FAAD14;
}

.budget-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}

.budget-date {
  font-size: 24rpx;
  color: #999999;
}

.budget-amount {
  font-size: 32rpx;
  font-weight: 600;
  color: #D4A574;
}

.budget-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}

.action-text {
  font-size: 24rpx;
  color: #D4A574;
}

.action-text.delete {
  color: #FF4D4F;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 90%;
  max-width: 640rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
}

.modal-close {
  font-size: 48rpx;
  color: #999999;
  line-height: 1;
}

.modal-body {
  padding: 32rpx;
}

.form-section {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #999999;
  display: block;
  margin-bottom: 16rpx;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #F5F5F5;
  border-radius: 16rpx;
  min-width: 100rpx;
}

.category-item.selected {
  background: #FDF8F3;
  border: 2rpx solid #D4A574;
}

.category-item text:first-child {
  font-size: 32rpx;
  margin-bottom: 8rpx;
}

.category-item text:last-child {
  font-size: 22rpx;
  color: #666666;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #F9F9F9;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  background: #F9F9F9;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.form-switch {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.switch-label {
  font-size: 28rpx;
  color: #333333;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #F0F0F0;
}

.modal-footer button {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #D4A574 0%, #C4956A 100%);
  color: #FFFFFF;
  border: none;
}

.btn-secondary {
  background: #F5F5F5;
  color: #333333;
  border: none;
}
