.wedding-container {
  padding: 32rpx;
  padding-bottom: 120rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}

.card-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.card-item {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.card-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.card-name {
  font-size: 26rpx;
  color: #333333;
  margin-bottom: 8rpx;
}

.card-count {
  font-size: 22rpx;
  color: #999999;
}

.quick-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.quick-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.quick-item:last-child {
  border-bottom: none;
}

.quick-icon {
  width: 60rpx;
  height: 60rpx;
  background: linear-gradient(135deg, #D4A574 0%, #C4956A 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #FFFFFF;
  margin-right: 20rpx;
}

.quick-text {
  font-size: 28rpx;
  color: #333333;
}
