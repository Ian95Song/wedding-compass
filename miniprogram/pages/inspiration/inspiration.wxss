.inspiration-container {
  padding-bottom: 120rpx;
}

.tab-bar {
  display: flex;
  background: #FFFFFF;
  padding: 24rpx 32rpx;
  gap: 32rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  font-size: 32rpx;
  font-weight: 500;
  color: #999999;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
}

.tab-item.active {
  color: #FFFFFF;
  background: linear-gradient(135deg, #D4A574 0%, #C4956A 100%);
}

.search-bar {
  padding: 24rpx 32rpx;
}

.search-input {
  width: 100%;
  max-width: 680rpx;
  height: 80rpx;
  padding: 0 32rpx;
  background: #FFFFFF;
  border-radius: 40rpx;
  font-size: 28rpx;
  line-height: 80rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

.tag-filter {
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}

.tag-scroll {
  white-space: nowrap;
}

.tag-list {
  display: inline-flex;
  gap: 16rpx;
}

.tag-item {
  display: inline-block;
  padding: 12rpx 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #666666;
  border: 2rpx solid #F0F0F0;
}

.tag-item.active {
  background: #D4A574;
  color: #FFFFFF;
  border-color: #D4A574;
}

.action-bar {
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}

.add-btn {
  width: 100%;
  background: linear-gradient(135deg, #D4A574 0%, #C4956A 100%);
  color: #FFFFFF;
  border-radius: 40rpx;
  padding: 24rpx;
  font-size: 28rpx;
}

.empty-state {
  text-align: center;
  padding: 80rpx 32rpx;
  background: #FFFFFF;
  margin: 0 32rpx;
  border-radius: 20rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  display: block;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999999;
}

.inspiration-list {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.inspiration-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
}

.xiaohongshu-card {
  display: flex;
  background: linear-gradient(135deg, #FFF5F5 0%, #FFFFFF 100%);
  border: 2rpx solid #FFE4E6;
  padding: 20rpx;
  position: relative;
}

.xiaohongshu-card:active {
  transform: scale(0.98);
}

.xhs-left {
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.xhs-icon-wrapper {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #FFE4E6 0%, #FFF5F5 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 71, 87, 0.15);
}

.xhs-icon-large {
  font-size: 60rpx;
}

.xhs-date {
  font-size: 20rpx;
  color: #999999;
}

.xhs-right {
  flex: 1;
  padding-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.xhs-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.xhs-logo {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.xhs-icon {
  font-size: 28rpx;
}

.xhs-brand {
  font-size: 22rpx;
  color: #FF4757;
  font-weight: 600;
}

.xhs-stats {
  display: flex;
  gap: 16rpx;
}

.stat-item {
  font-size: 22rpx;
  color: #FF4757;
}

.xhs-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.xhs-summary {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.xhs-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.xhs-tag {
  font-size: 20rpx;
  color: #D4A574;
  background: #FDF8F3;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
}

.xhs-footer {
  padding-top: 8rpx;
}

.xhs-hint {
  font-size: 20rpx;
  color: #FF4757;
}

.normal-card {
  padding: 20rpx;
}

.card-content {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.content-icon {
  font-size: 40rpx;
  flex-shrink: 0;
}

.content-text {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.card-tag {
  font-size: 22rpx;
  color: #D4A574;
  background: #FDF8F3;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
}

.card-date {
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 12rpx;
}

.card-actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}

.action-btn {
  width: 60rpx;
  height: 60rpx;
  background: #F5F5F5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.action-btn:active {
  background: #E8E8E8;
}

.delete-btn {
  background: #FFF0F0;
}

.case-filter {
  padding: 24rpx 32rpx;
  background: #FFFFFF;
}

.filter-section {
  margin-bottom: 24rpx;
}

.filter-section:last-child {
  margin-bottom: 0;
}

.filter-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 16rpx;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.filter-option {
  padding: 12rpx 24rpx;
  background: #F5F5F5;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #666666;
}

.filter-option.active {
  background: #D4A574;
  color: #FFFFFF;
}

.case-list {
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.case-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  display: flex;
}

.case-image {
  width: 240rpx;
  height: 180rpx;
}

.case-info {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
}

.case-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 12rpx;
}

.case-meta {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #999999;
}

.meta-divider {
  margin: 0 12rpx;
  color: #DDDDDD;
}

.case-tags {
  display: flex;
  gap: 12rpx;
}

.case-tag {
  font-size: 22rpx;
  color: #D4A574;
  background: #FDF8F3;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 650rpx;
  max-height: 85vh;
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.modal-close {
  font-size: 40rpx;
  color: #999999;
  line-height: 1;
}

.modal-body {
  padding: 32rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.type-selector {
  display: flex;
  justify-content: space-around;
  margin-bottom: 32rpx;
}

.type-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid #F0F0F0;
  width: 150rpx;
}

.type-option.active {
  border-color: #D4A574;
  background: #FDF8F3;
}

.type-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.type-name {
  font-size: 26rpx;
  color: #333333;
}

.loading-preview {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  margin-bottom: 24rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #F0F0F0;
  border-top-color: #FF4757;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 16rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #999999;
}

.preview-card {
  background: linear-gradient(135deg, #FFF5F5 0%, #FFFFFF 100%);
  border: 2rpx solid #FFE4E6;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.preview-header {
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #FFE4E6;
}

.preview-label {
  font-size: 26rpx;
  color: #FF4757;
  font-weight: 600;
}

.preview-content {
  display: flex;
  padding: 16rpx 20rpx;
}

.preview-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
}

.preview-info {
  flex: 1;
  padding-left: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.preview-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A1A;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.preview-summary {
  font-size: 22rpx;
  color: #999999;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.preview-stats {
  display: flex;
  gap: 16rpx;
}

.preview-stat {
  font-size: 20rpx;
  color: #FF4757;
}

.xiaohongshu-editor {
  background: linear-gradient(135deg, #FFF5F5 0%, #FFFFFF 100%);
  border: 2rpx solid #FFE4E6;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-top: 20rpx;
}

.xhs-editor-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.xhs-editor-icon {
  font-size: 32rpx;
}

.xhs-editor-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #FF4757;
}

.xhs-input-title {
  width: 100%;
  padding: 16rpx;
  background: #FFFFFF;
  border: 1rpx solid #FFE4E6;
  border-radius: 10rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.xhs-textarea-summary {
  width: 100%;
  padding: 16rpx;
  background: #FFFFFF;
  border: 1rpx solid #FFE4E6;
  border-radius: 10rpx;
  font-size: 26rpx;
  min-height: 120rpx;
}

.form-input {
  width: 100%;
  padding: 20rpx;
  border: 1rpx solid #E8E8E8;
  border-radius: 12rpx;
  font-size: 28rpx;
  margin-bottom: 32rpx;
}

.form-textarea {
  width: 100%;
  padding: 20rpx;
  border: 1rpx solid #E8E8E8;
  border-radius: 12rpx;
  font-size: 28rpx;
  min-height: 200rpx;
  margin-bottom: 32rpx;
}

.image-upload {
  margin-bottom: 32rpx;
}

.upload-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  border: 2rpx dashed #E8E8E8;
  border-radius: 12rpx;
}

.upload-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.upload-text {
  font-size: 26rpx;
  color: #999999;
}

.tag-selector {
  margin-bottom: 16rpx;
}

.selector-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 16rpx;
}

.selected-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
  min-height: 60rpx;
}

.no-tag-hint {
  font-size: 24rpx;
  color: #999999;
  padding: 12rpx 0;
}

.selected-tag {
  display: flex;
  align-items: center;
  padding: 10rpx 16rpx;
  background: linear-gradient(135deg, #D4A574 0%, #C4956A 100%);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #FFFFFF;
}

.tag-remove {
  margin-left: 8rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.tag-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-option {
  padding: 12rpx 24rpx;
  background: #F5F5F5;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #666666;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.tag-option.active {
  background: #D4A574;
  color: #FFFFFF;
  border: 2rpx solid #8B6914;
}

.tag-item {
  padding: 12rpx 20rpx;
  background: #F5F5F5;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #666666;
}

.tag-item.active {
  background: #FDF8F3;
  color: #D4A574;
  border: 2rpx solid #D4A574;
}

.modal-footer {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #F0F0F0;
}

.modal-footer button {
  flex: 1;
  padding: 24rpx;
  font-size: 28rpx;
  border-radius: 12rpx;
}

.btn-secondary {
  background: #F5F5F5;
  color: #333333;
}

.btn-primary {
  background: linear-gradient(135deg, #D4A574 0%, #C4956A 100%);
  color: #FFFFFF;
}