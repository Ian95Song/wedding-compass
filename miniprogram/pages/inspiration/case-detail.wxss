.case-detail-container {
  min-height: 100vh;
  background: #FDF8F3;
}

.case-cover {
  position: relative;
  height: 450rpx;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.cover-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
}

.case-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
  margin-bottom: 16rpx;
}

.case-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 24rpx;
  color: #FFFFFF;
  background: rgba(212, 165, 116, 0.9);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.case-content {
  padding: 32rpx;
  padding-bottom: 120rpx;
}

.section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.section-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.info-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  background: #FDF8F3;
  border-radius: 16rpx;
}

.info-icon {
  font-size: 40rpx;
  margin-bottom: 12rpx;
}

.info-label {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.info-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  text-align: center;
}

.highlights-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.highlight-item {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  background: linear-gradient(135deg, #FDF8F3 0%, #F5EDE5 100%);
  border-radius: 30rpx;
  border: 1rpx solid #E8D5C4;
}

.highlight-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
}

.highlight-text {
  font-size: 26rpx;
  color: #8B6914;
}

.expense-section {
  background: linear-gradient(135deg, #FFFFFF 0%, #FDF8F3 100%);
}

.total-cost {
  font-size: 36rpx;
  font-weight: 700;
  color: #D4A574;
}

.expense-list {
  margin-bottom: 0;
}

.expense-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx dashed #F0E8E0;
}

.expense-item:last-child {
  border-bottom: none;
}

.expense-label {
  font-size: 28rpx;
  color: #666666;
}

.expense-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx;
  background: #FDF8F3;
  border-radius: 12rpx;
}

.tip-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
}