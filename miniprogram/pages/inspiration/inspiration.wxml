<view class="inspiration-container">
  <view class="tab-bar">
    <view 
      wx:for="{{tabs}}" 
      wx:key="id" 
      class="tab-item {{activeTab === item.id ? 'active' : ''}}"
      bindtap="switchTab"
      data-id="{{item.id}}"
    >
      {{item.name}}
    </view>
  </view>

  <view wx:if="{{activeTab === 'inspiration'}}">
    <view class="search-bar">
      <input class="search-input" placeholder="搜索灵感..." value="{{searchText}}" bindinput="onSearchInput" />
    </view>

    <view class="tag-filter">
      <scroll-view scroll-x class="tag-scroll">
        <view class="tag-list">
          <view 
            wx:for="{{tags}}" 
            wx:key="*this" 
            class="tag-item {{selectedTag === item ? 'active' : ''}}"
            bindtap="selectTag"
            data-tag="{{item}}"
          >
            {{item}}
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="action-bar">
      <button class="add-btn" bindtap="addInspiration">+ 添加灵感</button>
    </view>

    <view wx:if="{{filteredInspirations.length === 0}}" class="empty-state">
      <text class="empty-icon">💡</text>
      <text class="empty-title">暂无灵感</text>
      <text class="empty-desc">点击上方按钮添加你的第一个灵感</text>
    </view>

    <view wx:else class="inspiration-list">
      <view 
        wx:for="{{filteredInspirations}}" 
        wx:key="id" 
        class="inspiration-card"
        bindtap="viewInspiration"
        data-id="{{item.id}}"
      >
        <view wx:if="{{item.platform === 'xiaohongshu' && item.preview}}" class="xiaohongshu-card">
          <view class="xhs-left">
            <view class="xhs-icon-wrapper">
              <text class="xhs-icon-large">📕</text>
            </view>
          </view>
          <view class="xhs-right">
            <view class="xhs-header">
              <view class="xhs-logo">
                <text class="xhs-icon">📕</text>
                <text class="xhs-brand">小红书</text>
              </view>
              <text class="xhs-date">{{item.date}}</text>
            </view>
            <text class="xhs-title">{{item.preview.title}}</text>
            <text class="xhs-summary">{{item.preview.summary}}</text>
            <view class="xhs-tags">
              <text wx:for="{{item.tags}}" wx:key="*this" class="xhs-tag">{{item}}</text>
            </view>
            <view class="xhs-footer">
              <text class="xhs-hint">👆 点击复制链接并打开小红书</text>
            </view>
          </view>
        </view>

        <view wx:else class="normal-card">
          <view class="card-content">
            <text class="content-icon">{{item.type === 'link' ? '🔗' : item.type === 'image' ? '🖼️' : '📝'}}</text>
            <text class="content-text">{{item.content}}</text>
          </view>
          <view class="card-tags">
            <text wx:for="{{item.tags}}" wx:key="*this" class="card-tag">{{item}}</text>
          </view>
          <view class="card-date">{{item.date}}</view>
          <view class="card-actions">
            <view wx:if="{{item.type === 'link'}}" class="action-btn" bindtap="copyLink" data-id="{{item.id}}">
              <text>📋</text>
            </view>
            <view class="action-btn delete-btn" bindtap="deleteInspiration" data-id="{{item.id}}">
              <text>🗑️</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:else>
    <view class="case-filter">
      <view class="filter-section">
        <text class="filter-label">预算</text>
        <view class="filter-options">
          <view 
            wx:for="{{caseTags.budget}}" 
            wx:key="*this" 
            class="filter-option {{selectedBudget === item ? 'active' : ''}}"
            bindtap="selectBudget"
            data-value="{{item}}"
          >
            {{item}}
          </view>
        </view>
      </view>
      <view class="filter-section">
        <text class="filter-label">风格</text>
        <view class="filter-options">
          <view 
            wx:for="{{caseTags.style}}" 
            wx:key="*this" 
            class="filter-option {{selectedStyle === item ? 'active' : ''}}"
            bindtap="selectStyle"
            data-value="{{item}}"
          >
            {{item}}
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{filteredCases.length === 0}}" class="empty-state">
      <text class="empty-icon">📚</text>
      <text class="empty-title">暂无案例</text>
      <text class="empty-desc">暂无符合条件的婚礼案例</text>
    </view>

    <view wx:else class="case-list">
      <view 
        wx:for="{{filteredCases}}" 
        wx:key="id" 
        class="case-card"
        bindtap="viewCase"
        data-id="{{item.id}}"
      >
        <image class="case-image" src="{{item.coverImage}}" mode="aspectFill" />
        <view class="case-info">
          <text class="case-title">{{item.title}}</text>
          <view class="case-meta">
            <text class="meta-item">{{item.city}}</text>
            <text class="meta-divider">·</text>
            <text class="meta-item">{{item.venueType}}</text>
          </view>
          <view class="case-tags">
            <text class="case-tag">{{item.budget}}</text>
            <text class="case-tag">{{item.style}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>

<view wx:if="{{showAddModal}}" class="modal-overlay" bindtap="closeModal">
  <view class="modal-content" catchtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">添加灵感</text>
      <text class="modal-close" bindtap="closeModal">×</text>
    </view>
    <view class="modal-body">
      <view class="type-selector">
        <view 
          wx:for="{{types}}" 
          wx:key="id" 
          class="type-option {{formData.type === item.id ? 'active' : ''}}"
          bindtap="selectType"
          data-type="{{item.id}}"
        >
          <text class="type-icon">{{item.icon}}</text>
          <text class="type-name">{{item.name}}</text>
        </view>
      </view>

      <view wx:if="{{formData.type === 'link'}}">
        <input class="form-input" placeholder="粘贴链接..." value="{{formData.content}}" bindinput="onContentInput" />
        
        <view wx:if="{{formData.isXiaohongshu}}" class="xiaohongshu-editor">
          <view class="xhs-editor-header">
            <text class="xhs-editor-icon">📕</text>
            <text class="xhs-editor-title">小红书笔记信息</text>
          </view>
          <input class="xhs-input-title" placeholder="笔记标题" value="{{formData.preview.title}}" bindinput="onPreviewTitleInput" />
          <textarea class="xhs-textarea-summary" placeholder="笔记摘要（可选）" value="{{formData.preview.summary}}" bindinput="onPreviewSummaryInput" />
        </view>
      </view>

      <textarea wx:if="{{formData.type === 'text'}}" class="form-textarea" placeholder="输入灵感内容..." value="{{formData.content}}" bindinput="onContentInput" />

      <view wx:if="{{formData.type === 'image'}}" class="image-upload">
        <view class="upload-btn" bindtap="uploadImage">
          <text class="upload-icon">📷</text>
          <text class="upload-text">选择图片</text>
        </view>
        <image wx:if="{{formData.content}}" class="preview-image" src="{{formData.content}}" mode="aspectFill" />
      </view>
      
      <view class="tag-selector">
        <text class="selector-label">已选标签</text>
        <view class="selected-tags">
          <view wx:if="{{!formData.tags.length}}" class="no-tag-hint">
            暂无选中标签，请从下方选择
          </view>
          <view 
            wx:for="{{formData.tags}}" 
            wx:key="*this" 
            class="selected-tag"
          >
            {{item}}
            <text class="tag-remove" bindtap="removeTag" data-tag="{{item}}">×</text>
          </view>
        </view>
        
        <text class="selector-label">可选标签</text>
        <view class="tag-options">
          <view 
            wx:for="{{tags}}" 
            wx:key="*this" 
            class="tag-item"
            bindtap="toggleTag"
            data-tag="{{item}}"
          >
            {{item}}
          </view>
        </view>
      </view>
    </view>
    <view class="modal-footer">
      <button class="btn-secondary" bindtap="closeModal">取消</button>
      <button class="btn-primary" bindtap="saveInspiration">保存</button>
    </view>
  </view>
</view>