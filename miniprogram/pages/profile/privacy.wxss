.privacy-container {
  min-height: 100vh;
  background: #FDF8F3;
  box-sizing: border-box;
}

.tab-bar {
  display: flex;
  background: #FFFFFF;
  padding: 24rpx 32rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  border-bottom: 1rpx solid #F0F0F0;
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  padding: 16rpx;
  color: #999999;
  border-radius: 24rpx;
}

.tab-item.active {
  color: #FFFFFF;
  background: linear-gradient(135deg, #D4A574 0%, #C4956A 100%);
}

.content-scroll {
  height: calc(100vh - 88rpx);
  padding: 24rpx;
  box-sizing: border-box;
}

.content {
  padding-bottom: 48rpx;
}

.section {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  word-break: break-all;
  overflow-wrap: break-word;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.section-content {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
  word-break: break-all;
  overflow-wrap: break-word;
}

.text {
  display: block;
  word-break: break-all;
  overflow-wrap: break-word;
}

.list {
  margin-top: 16rpx;
}

.list-item {
  display: block;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  color: #666666;
  word-break: break-all;
  overflow-wrap: break-word;
}

.last-update {
  text-align: center;
  padding: 32rpx;
}

.last-update .text {
  font-size: 24rpx;
  color: #999999;
}