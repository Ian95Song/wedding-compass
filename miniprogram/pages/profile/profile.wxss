.profile-container {
  padding: 32rpx;
  padding-bottom: 120rpx;
}

.user-card {
  background: linear-gradient(135deg, #D4A574 0%, #C4956A 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin-right: 24rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
  display: block;
  margin-bottom: 8rpx;
}

.wedding-date {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.edit-btn {
  padding: 16rpx 32rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #FFFFFF;
}

.section-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}

.tool-list, .setting-list, .about-list {
  display: flex;
  flex-direction: column;
}

.tool-item, .setting-item, .about-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.tool-item:last-child, .setting-item:last-child, .about-item:last-child {
  border-bottom: none;
}

.tool-icon, .setting-icon, .about-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.tool-info {
  flex: 1;
}

.tool-name, .setting-name, .about-name {
  font-size: 28rpx;
  color: #333333;
  display: block;
  margin-bottom: 4rpx;
}

.tool-desc, .setting-desc {
  font-size: 24rpx;
  color: #999999;
}

.tool-arrow, .setting-arrow, .about-arrow {
  font-size: 32rpx;
  color: #999999;
}

.setting-switch {
  transform: scale(0.8);
}

.about-value {
  font-size: 28rpx;
  color: #999999;
  margin-left: auto;
}

.footer {
  text-align: center;
  padding: 40rpx;
}

.footer-text {
  font-size: 24rpx;
  color: #999999;
}

.date-picker-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
}

.picker-label {
  font-size: 28rpx;
  color: #999999;
  margin-right: 16rpx;
}

.picker-value {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.picker-arrow {
  font-size: 32rpx;
  color: #999999;
}

.lucky-calendar {
  width: 100%;
}

.calendar-header {
  text-align: center;
  margin-bottom: 24rpx;
}

.calendar-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.calendar-weekdays {
  display: flex;
  justify-content: space-around;
  margin-bottom: 16rpx;
}

.weekday {
  font-size: 26rpx;
  color: #999999;
  width: 80rpx;
  text-align: center;
}

.calendar-days {
  display: flex;
  flex-wrap: wrap;
}

.day-item {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #333333;
}

.day-item.today {
  background: #D4A574;
  color: #FFFFFF;
  border-radius: 50%;
}

.day-item.lucky {
  color: #52C41A;
  font-weight: 600;
}
