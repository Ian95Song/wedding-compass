<view class="profile-container">
  <view class="user-card">
    <view class="user-avatar">👰</view>
    <view class="user-info">
      <text class="user-name">{{userInfo.nickname || '准新人'}}</text>
      <text class="wedding-date">婚期：{{weddingDateCN || '未设置'}}</text>
    </view>
    <view class="edit-btn" bindtap="editProfile">编辑</view>
  </view>

  <view class="section-card">
    <view class="section-title">设置</view>
    <view class="setting-list">
      <view class="setting-item" bindtap="goToPrivacy">
        <view class="setting-icon">🔒</view>
        <view class="setting-info">
          <text class="setting-name">隐私设置</text>
          <text class="setting-desc">用户协议与隐私政策</text>
        </view>
        <text class="setting-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="section-card">
    <view class="section-title">关于</view>
    <view class="about-list">
      <view class="about-item" bindtap="showHelp">
        <view class="about-icon">❓</view>
        <text class="about-name">使用指南</text>
        <text class="about-arrow">›</text>
      </view>
      <view class="about-item">
        <view class="about-icon">📱</view>
        <text class="about-name">版本号</text>
        <text class="about-value">v1.0.0</text>
      </view>
    </view>
  </view>

  <view class="footer">
    <text class="footer-text">备婚手账本 - 让备婚更轻松</text>
  </view>
</view>

<view wx:if="{{showEditModal}}" class="modal-overlay" bindtap="closeEditModal">
  <view class="modal-content" catchtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">编辑资料</text>
      <text class="modal-close" bindtap="closeEditModal">×</text>
    </view>
    <view class="modal-body">
      <input class="form-input" placeholder="昵称" value="{{formData.nickname}}" bindinput="onNicknameInput" />
      <picker mode="date" value="{{formData.weddingDate}}" bindchange="onWeddingDateChange">
        <view class="date-picker-item">
          <text class="picker-label">婚期</text>
          <text class="picker-value">{{formData.weddingDate || '请选择'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>
    <view class="modal-footer">
      <button class="btn-secondary" bindtap="closeEditModal">取消</button>
      <button class="btn-primary" bindtap="saveProfile">保存</button>
    </view>
  </view>
</view>
