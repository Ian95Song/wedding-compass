.container {
  padding: 32rpx;
  padding-bottom: 120rpx;
}

.welcome-card {
  text-align: center;
  padding: 60rpx 32rpx;
  background: linear-gradient(135deg, #D4A574 0%, #E8B4B8 100%);
}

.welcome-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.welcome-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 16rpx;
}

.welcome-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 40rpx;
}

.welcome-btn {
  background: #FFFFFF;
  color: #D4A574;
  border-radius: 40rpx;
  padding: 24rpx 64rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.countdown-card {
  text-align: center;
  padding: 40rpx 32rpx;
  background: linear-gradient(135deg, #D4A574 0%, #C4956A 100%);
}

.countdown-content {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 16rpx;
}

.countdown-number {
  font-size: 120rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1;
}

.countdown-unit {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-left: 8rpx;
}

.countdown-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 8rpx;
}

.countdown-date {
  font-size: 32rpx;
  font-weight: 500;
  color: #FFFFFF;
  margin-bottom: 16rpx;
}

.countdown-edit {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.progress-card {
  padding: 32rpx;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.progress-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.progress-link {
  font-size: 26rpx;
  color: #D4A574;
}

.progress-ring-container {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto 24rpx;
}

.progress-ring {
  position: absolute;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: conic-gradient(#D4A574 0deg, #D4A574 var(--progress, 0deg), transparent var(--progress, 0deg));
  display: flex;
  align-items: center;
  justify-content: center;
}

.progress-ring-inner {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.progress-percent {
  font-size: 36rpx;
  font-weight: 600;
  color: #D4A574;
}

.progress-ring-bg {
  position: absolute;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: #F5F5F5;
}

.progress-text {
  text-align: center;
  font-size: 26rpx;
  color: #999999;
}

.today-tasks-card {
  padding: 32rpx;
}

.task-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.task-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.task-link {
  font-size: 26rpx;
  color: #D4A574;
}

.empty-tasks {
  text-align: center;
  padding: 40rpx 0;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
  display: block;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

.task-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.task-item:last-child {
  border-bottom: none;
}

.task-item.removing {
  opacity: 0;
  transform: translateX(100rpx);
  height: 0;
  padding: 0;
  margin: 0;
  overflow: hidden;
}

.task-checkbox {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.checkbox-inner {
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid #D4A574;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  background: transparent;
}

.checkbox-inner.checked {
  background: linear-gradient(135deg, #D4A574 0%, #C4956A 100%);
  border-color: #D4A574;
  animation: checkPop 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55);
}

@keyframes checkPop {
  0% {
    transform: scale(0);
  }
  50% {
    transform: scale(1.2);
  }
  100% {
    transform: scale(1);
  }
}

.check-icon {
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  animation: iconAppear 0.2s ease-out;
}

@keyframes iconAppear {
  0% {
    opacity: 0;
    transform: scale(0.5);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

.task-content {
  flex: 1;
  transition: all 0.3s ease;
}

.task-name {
  font-size: 28rpx;
  color: #333333;
  display: block;
  margin-bottom: 8rpx;
  transition: all 0.3s ease;
  position: relative;
}

.task-name.completed {
  color: #999999;
}

.task-name.completed::after {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  width: 100%;
  height: 2rpx;
  background: #999999;
  animation: strikeThrough 0.3s ease-out forwards;
}

@keyframes strikeThrough {
  0% {
    width: 0;
  }
  100% {
    width: 100%;
  }
}

.task-desc {
  font-size: 24rpx;
  color: #999999;
  display: block;
  transition: all 0.3s ease;
}

.task-item.removing .task-desc {
  opacity: 0;
}

.quick-actions {
  padding: 32rpx;
}

.action-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.action-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.action-name {
  font-size: 24rpx;
  color: #333333;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-container {
  width: 90%;
  max-width: 640rpx;
  max-height: 80vh;
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
  flex-shrink: 0;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
}

.modal-close {
  font-size: 48rpx;
  color: #999999;
  line-height: 1;
}

.modal-body {
  padding: 32rpx;
  overflow-y: auto;
  flex: 1;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #999999;
  display: block;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #F9F9F9;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.form-textarea {
  width: 100%;
  height: 120rpx;
  background: #F9F9F9;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-tag {
  padding: 16rpx 28rpx;
  background: #F5F5F5;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #666666;
}

.category-tag.active {
  background: #FDF8F3;
  color: #D4A574;
  border: 2rpx solid #D4A574;
}

.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-item {
  padding: 12rpx 20rpx;
  background: #F5F5F5;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #666666;
}

.tag-item.active {
  background: #FDF8F3;
  color: #D4A574;
  border: 2rpx solid #D4A574;
}

.upload-area {
  width: 100%;
  height: 200rpx;
  background: #F9F9F9;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #D4A574;
}

.upload-text {
  font-size: 28rpx;
  color: #999999;
}

.preview-image {
  width: 100%;
  height: 200rpx;
  border-radius: 16rpx;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #F0F0F0;
  flex-shrink: 0;
}

.modal-footer button {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
}

.btn-cancel {
  background: #F5F5F5;
  color: #333333;
  border: none;
}

.btn-confirm {
  background: linear-gradient(135deg, #D4A574 0%, #C4956A 100%);
  color: #FFFFFF;
  border: none;
}

.image-upload {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.uploaded-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.image-delete {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  background: #FF4D4F;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 28rpx;
}

.upload-btn {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #D4A574;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-icon {
  font-size: 48rpx;
  color: #D4A574;
}

.privacy-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.privacy-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
}

.privacy-content {
  position: relative;
  width: 85%;
  max-width: 640rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
}

.privacy-header {
  padding: 40rpx 32rpx 24rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  text-align: center;
  border-bottom: 1rpx solid #F0F0F0;
}

.privacy-body {
  padding: 32rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.privacy-intro {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.privacy-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.privacy-link {
  font-size: 30rpx;
  color: #D4A574;
  text-decoration: underline;
}

.privacy-arrow {
  font-size: 32rpx;
  color: #D4A574;
}

.privacy-summary {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #FDF8F3;
  border-radius: 16rpx;
}

.summary-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.summary-item {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.8;
}

.privacy-footer {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #F0F0F0;
}

.btn-refuse {
  flex: 1;
  height: 88rpx;
  background: #F5F5F5;
  color: #666666;
  border: none;
  border-radius: 44rpx;
  font-size: 30rpx;
}

.btn-agree {
  flex: 1;
  height: 88rpx;
  background: linear-gradient(135deg, #D4A574 0%, #C4956A 100%);
  color: #FFFFFF;
  border: none;
  border-radius: 44rpx;
  font-size: 30rpx;
}
