/* ========== CSS Variables ========== */
page {
  --color-primary: #D4A574;
  --color-primary-dark: #C4956A;
  --color-secondary: #E8B4B8;
  --color-bg-page: #FDF8F3;
  --color-bg-white: #FFFFFF;
  --color-bg-light: #F5F5F5;
  --color-bg-input: #F9F9F9;
  --color-border: #F0F0F0;
  --color-text-main: #333333;
  --color-text-secondary: #666666;
  --color-text-muted: #999999;
  --color-danger: #FF4D4F;
  --color-success: #52C41A;
  --color-warning: #FAAD14;
  --gradient-primary: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  --gradient-primary-pink: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
  --shadow-card: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  --radius-card: 24rpx;
  --radius-pill: 40rpx;
  --radius-input: 16rpx;

  background-color: var(--color-bg-page);
  font-family: "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  padding-top: env(safe-area-inset-top);
}

page::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: var(--color-bg-page);
  z-index: 9999;
}

/* ========== Page Container ========== */
.container {
  padding: 32rpx;
}

.page-container {
  padding: 32rpx;
  padding-bottom: 120rpx;
}

/* ========== Card ========== */
.card {
  background: var(--color-bg-white);
  border-radius: var(--radius-card);
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

/* ========== Buttons ========== */
.btn-primary {
  background: var(--gradient-primary);
  color: var(--color-bg-white);
  border-radius: var(--radius-pill);
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}

.btn-secondary {
  background: var(--color-bg-light);
  color: var(--color-text-main);
  border-radius: var(--radius-pill);
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  border: none;
}

.add-btn {
  width: 100%;
  background: var(--gradient-primary);
  color: var(--color-bg-white);
  border-radius: var(--radius-pill);
  padding: 28rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}

/* ========== Text Utilities ========== */
.text-primary { color: var(--color-primary); }
.text-secondary { color: var(--color-secondary); }
.text-main { color: var(--color-text-main); }
.text-muted { color: var(--color-text-muted); }
.text-success { color: var(--color-success); }
.text-warning { color: var(--color-warning); }
.text-danger { color: var(--color-danger); }
.text-center { text-align: center; }

/* ========== Flex Utilities ========== */
.flex { display: flex; }
.flex-column { flex-direction: column; }
.flex-center { align-items: center; justify-content: center; }
.flex-between { justify-content: space-between; }
.flex-wrap { flex-wrap: wrap; }
.flex-1 { flex: 1; }

/* ========== Spacing ========== */
.mt-1 { margin-top: 16rpx; }
.mt-2 { margin-top: 24rpx; }
.mt-3 { margin-top: 32rpx; }
.mb-1 { margin-bottom: 16rpx; }
.mb-2 { margin-bottom: 24rpx; }
.mb-3 { margin-bottom: 32rpx; }

/* ========== Font ========== */
.font-bold { font-weight: 600; }
.font-medium { font-weight: 500; }
.text-lg { font-size: 32rpx; }
.text-sm { font-size: 24rpx; }
.text-xs { font-size: 22rpx; }

/* ========== Modal System ========== */
.modal-mask,
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-container,
.modal-content {
  width: 90%;
  max-width: 650rpx;
  max-height: 80vh;
  background: var(--color-bg-white);
  border-radius: var(--radius-card);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--color-border);
  flex-shrink: 0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-main);
}

.modal-close {
  font-size: 48rpx;
  color: var(--color-text-muted);
  line-height: 1;
}

.modal-body {
  padding: 32rpx;
  max-height: 70vh;
  overflow-y: auto;
  flex: 1;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid var(--color-border);
  flex-shrink: 0;
}

.modal-footer button {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
}

/* ========== Form Elements ========== */
.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: var(--color-text-muted);
  display: block;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: var(--color-bg-input);
  border-radius: var(--radius-input);
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  background: var(--color-bg-input);
  border-radius: var(--radius-input);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.option-item {
  padding: 16rpx 32rpx;
  background: var(--color-bg-input);
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.option-item.selected {
  background: var(--gradient-primary);
  color: var(--color-bg-white);
}

.form-switch-wrapper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--color-bg-input);
  border-radius: var(--radius-input);
  padding: 20rpx 24rpx;
}

.form-switch-label {
  font-size: 28rpx;
  color: var(--color-text-main);
}

/* ========== Empty State ========== */
.empty-state {
  text-align: center;
  padding: 80rpx 32rpx;
  background: var(--color-bg-white);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-main);
  display: block;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--color-text-muted);
}

/* ========== Summary Card ========== */
.summary-card {
  background: var(--gradient-primary);
  border-radius: var(--radius-card);
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.summary-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.summary-item:not(:last-child) {
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.2);
}

.summary-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.summary-value {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-bg-white);
}

/* ========== Action Bar ========== */
.action-bar {
  margin-bottom: 24rpx;
}

/* ========== Search Bar ========== */
.search-bar {
  display: flex;
  align-items: center;
  background: var(--color-bg-white);
  border-radius: var(--radius-pill);
  padding: 0 24rpx;
  height: 80rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  color: var(--color-text-muted);
}

.search-input {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
}

/* ========== Image Upload ========== */
.image-upload {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.uploaded-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.image-delete {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  background: var(--color-danger);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-bg-white);
  font-size: 28rpx;
}

.upload-btn {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed var(--color-primary);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-icon {
  font-size: 48rpx;
  color: var(--color-primary);
}

.upload-text {
  font-size: 22rpx;
  color: var(--color-primary);
  margin-top: 8rpx;
}

/* ========== Progress Bar ========== */
.progress-bar {
  height: 16rpx;
  background: var(--color-bg-light);
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--color-primary) 0%, var(--color-secondary) 100%);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

/* ========== Paid Badge ========== */
.paid-badge {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.paid-badge.paid {
  background: #E6F7E6;
  color: var(--color-success);
}

.paid-badge.unpaid {
  background: #FFF7E6;
  color: var(--color-warning);
}

/* ========== Action Text ========== */
.action-text {
  font-size: 24rpx;
  color: var(--color-primary);
}

.action-text.delete {
  color: var(--color-danger);
}

/* ========== Category Grid ========== */
.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 24rpx;
  background: var(--color-bg-light);
  border-radius: var(--radius-input);
  min-width: 100rpx;
}

.category-item.selected {
  background: var(--color-bg-page);
  border: 2rpx solid var(--color-primary);
}

.category-item text:first-child {
  font-size: 32rpx;
  margin-bottom: 8rpx;
}

.category-item text:last-child {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.category-tag {
  padding: 16rpx 28rpx;
  background: var(--color-bg-light);
  border-radius: var(--radius-card);
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.category-tag.active {
  background: var(--color-bg-page);
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
}
