page {
  background-color: #FDF8F3;
  font-family: "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  padding-top: env(safe-area-inset-top);
}

page::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: #FDF8F3;
  z-index: 9999;
}

.container {
  padding: 32rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.btn-primary {
  background: linear-gradient(135deg, #D4A574 0%, #C4956A 100%);
  color: #FFFFFF;
  border-radius: 40rpx;
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}

.btn-secondary {
  background: #F5F5F5;
  color: #333333;
  border-radius: 40rpx;
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  border: none;
}

.text-primary {
  color: #D4A574;
}

.text-secondary {
  color: #E8B4B8;
}

.text-main {
  color: #333333;
}

.text-muted {
  color: #999999;
}

.text-success {
  color: #52C41A;
}

.text-warning {
  color: #FAAD14;
}

.text-danger {
  color: #FF4D4F;
}

.flex {
  display: flex;
}

.flex-column {
  flex-direction: column;
}

.flex-center {
  align-items: center;
  justify-content: center;
}

.flex-between {
  justify-content: space-between;
}

.flex-wrap {
  flex-wrap: wrap;
}

.flex-1 {
  flex: 1;
}

.mt-1 { margin-top: 16rpx; }
.mt-2 { margin-top: 24rpx; }
.mt-3 { margin-top: 32rpx; }
.mb-1 { margin-bottom: 16rpx; }
.mb-2 { margin-bottom: 24rpx; }
.mb-3 { margin-bottom: 32rpx; }

.text-center {
  text-align: center;
}

.font-bold {
  font-weight: 600;
}

.font-medium {
  font-weight: 500;
}

.text-lg {
  font-size: 32rpx;
}

.text-sm {
  font-size: 24rpx;
}

.text-xs {
  font-size: 22rpx;
}
